---
// The mark and the name go back to the product site, not the docs root.
import glideMark from '../assets/glide-mark.svg?raw';
---
<a href="/" class="site-title sl-flex" aria-label="Glide home">
  <span class="mark" set:html={glideMark} />
  <span>Glide</span>
</a>
<style>
  .site-title { align-items: center; gap: var(--sl-nav-gap); font-size: var(--sl-text-h4); font-weight: 600; color: var(--sl-color-text-accent); text-decoration: none; white-space: nowrap; }
  .mark { display: inline-flex; width: 1.6rem; height: 1.6rem; }
  .mark :global(svg) { width: 100%; height: 100%; }
</style>
